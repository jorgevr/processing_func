<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DatasetProcessingFunction.Application\DatasetProcessingFunction.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <!-- Draft 2020-12 JSON Schema validator (R3.7, ADR 0004 rule 3) — format assertion is left at
         its library default (off) deliberately: every `format` in the vendored contract carries an
         equivalent `pattern`, so validation must not depend on an optional format-assertion vocabulary. -->
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
    <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.10.0" />
    <PackageReference Include="Parquet.Net" Version="4.23.5" />
    <!-- Direct pin: overrides vulnerable transitive Snappier from Parquet.Net (GHSA-pggp-6c3x-2xmx). Remove only when Parquet.Net depends on >= 1.3.1. -->
    <!-- Direct pin overriding the vulnerable Snappier 1.1.1 pulled transitively via
         Parquet.Net -> IronCompress (NU1903, GHSA-pggp-6c3x-2xmx, fixed in 1.3.1). -->
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DatasetProcessingFunction.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Embedded, not read from disk at runtime (AGENTS.md §6 — anything read at runtime is inside
       the image): the vendored copy is baked into this assembly at compile time, so no Dockerfile
       COPY step is needed and the validator can never read a stale or missing file. The on-disk
       copy at schemas/contracts/dataset-available.v1.json is kept byte-identical to the root
       contracts/ copy for the workspace drift check (ADR 0004 rule 4) and is this ItemGroup's
       source, not a runtime dependency. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\contracts\dataset-available.v1.json">
      <LogicalName>DatasetProcessingFunction.Infrastructure.Contracts.dataset-available.v1.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
