<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DatasetProcessingFunction.Application\DatasetProcessingFunction.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Azure.Storage.Files.DataLake" Version="12.27.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.10.0" />
    <PackageReference Include="Parquet.Net" Version="4.23.5" />
    <!-- Direct pin: overrides vulnerable transitive Snappier from Parquet.Net (GHSA-pggp-6c3x-2xmx). Remove only when Parquet.Net depends on >= 1.3.1. -->
    <!-- Direct pin overriding the vulnerable Snappier 1.1.1 pulled transitively via
         Parquet.Net -> IronCompress (NU1903, GHSA-pggp-6c3x-2xmx, fixed in 1.3.1). -->
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DatasetProcessingFunction.UnitTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
